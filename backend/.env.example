# Copy this file to .env and fill in your values

# --- AI Cafe / OpenAI-compatible API ---
API_KEY=your-aicafe-api-key-here
AICAFE_BASE_URL=https://aicafe.hcl.com
AICAFE_DEPLOYMENT_NAME=gpt-4.1
AICAFE_API_VERSION=2024-02-15-preview
ALLOW_LOCAL_FALLBACK=false

# --- JWT Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please-use-a-very-long-random-secret-in-production

# --- Resend Email Service ---
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# --- App URL (used in email links) ---
APP_URL=http://localhost:5175

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
